<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FIFA Career Companion</title>
  <style>
    :root {
      --bg-color: #0f1115;
      --card-bg: #181b20;
      --accent-color: #00ff66;
      --accent-hover: #00cc52;
      --text-color: #ffffff;
      --text-muted: #8b9199;
      --border-color: #2b2e33;
      --danger: #ff4d4d;
      --warning: #ffcc00;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-color);
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
    }

    /* Header */
    header {
      background-color: var(--card-bg);
      padding: 12px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border-color);
    }

    .club-title {
      font-weight: bold;
      font-size: 1.1rem;
      color: var(--accent-color);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .club-meta {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    /* Navigation Tabs */
    nav {
      display: flex;
      background-color: #131519;
      border-bottom: 1px solid var(--border-color);
    }

    .nav-btn {
      flex: 1;
      padding: 12px;
      background: none;
      border: none;
      color: var(--text-muted);
      font-weight: bold;
      font-size: 0.8rem;
      cursor: pointer;
      text-transform: uppercase;
      transition: all 0.2s;
      border-bottom: 3px solid transparent;
    }

    .nav-btn.active {
      color: var(--accent-color);
      border-bottom-color: var(--accent-color);
      background-color: var(--card-bg);
    }

    /* Main Container */
    main {
      flex: 1;
      overflow-y: auto;
      padding: 15px;
      position: relative;
    }

    .tab-content {
      display: none;
      height: 100%;
    }

    .tab-content.active {
      display: flex;
      flex-direction: column;
    }

    /* Chat Tab */
    .chat-box {
      flex: 1;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding-bottom: 15px;
    }

    .message {
      max-width: 85%;
      padding: 12px 16px;
      border-radius: 12px;
      font-size: 0.95rem;
      line-height: 1.4;
    }

    .message.ai {
      background-color: var(--card-bg);
      border-left: 3px solid var(--accent-color);
      align-self: flex-start;
    }

    .message.user {
      background-color: var(--accent-color);
      color: #000;
      font-weight: 500;
      align-self: flex-end;
    }

    /* MODIFICA: Aggiunto spazio inferiore per non far tagliare la barra dai tasti del telefono */
    .chat-input-area {
      display: flex;
      gap: 10px;
      background-color: var(--card-bg);
      padding: 10px;
      border-radius: 10px;
      border: 1px solid var(--border-color);
      margin-bottom: 35px; 
    }

    .chat-input-area input {
      flex: 1;
      background: none;
      border: none;
      color: var(--text-color);
      font-size: 0.95rem;
      outline: none;
    }

    .chat-input-area button {
      background-color: var(--accent-color);
      color: #000;
      border: none;
      padding: 8px 16px;
      border-radius: 6px;
      font-weight: bold;
      cursor: pointer;
    }

    /* Club Management Tab */
    .dashboard-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 12px;
      margin-bottom: 15px;
    }

    .card {
      background-color: var(--card-bg);
      padding: 15px;
      border-radius: 10px;
      border: 1px solid var(--border-color);
    }

    .card-title {
      font-size: 0.75rem;
      color: var(--text-muted);
      text-transform: uppercase;
      margin-bottom: 5px;
    }

    .card-value {
      font-size: 1.2rem;
      font-weight: bold;
    }

    .strike-pill {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 12px;
      font-size: 0.8rem;
      font-weight: bold;
      background-color: rgba(255, 77, 77, 0.2);
      color: var(--danger);
    }
  </style>
</head>
<body>

  <header>
    <div>
      <div class="club-title">Sunderland AFC</div>
      <div class="club-meta">Stagione 2017/18 • Premier League</div>
    </div>
    <div style="text-align: right;">
      <div class="card-value" style="font-size: 1rem;">3° POSTO</div>
      <div class="club-meta">Strikes: <span class="strike-pill">0 / 2.5</span></div>
    </div>
  </header>

  <nav>
    <button class="nav-btn active" onclick="switchTab('chat')">💬 Direttore IA</button>
    <button class="nav-btn" onclick="switchTab('club')">📊 Gestione Club</button>
  </nav>

  <main>
    <div id="tab-chat" class="tab-content active">
      <div class="chat-box" id="chatBox">
        <div class="message ai">
          <strong>Direttore Sportivo:</strong><br>
          Benvenuto Mister! Siamo al 3° posto in Premier League, agli ottavi di Champions e in semifinale di EFL Cup. Inserisci i prossimi risultati o le tue richieste di mercato qui sotto!
        </div>
      </div>
      <div class="chat-input-area">
        <input type="text" id="userInput" placeholder="Es: Registra Sunderland 2-1 Everton..." onkeydown="if(event.key === 'Enter') sendMessage()" />
        <button onclick="sendMessage()">Invia</button>
      </div>
    </div>

    <div id="tab-club" class="tab-content">
      <div class="dashboard-grid">
        <div class="card">
          <div class="card-title">Posizione</div>
          <div class="card-value">3° Posto</div>
        </div>
        <div class="card">
          <div class="card-title">Strikes</div>
          <div class="card-value" style="color: var(--accent-color);">0 / 2.5</div>
        </div>
        <div class="card">
          <div class="card-title">Champions League</div>
          <div class="card-value">Ottavi</div>
        </div>
        <div class="card">
          <div class="card-title">EFL Cup</div>
          <div class="card-value">Semifinale</div>
        </div>
      </div>
    </div>
  </main>

  <script>
    function switchTab(tabName) {
      document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
      document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('active'));
      
      document.getElementById('tab-' + tabName).classList.add('active');
      event.currentTarget.classList.add('active');
    }

    function sendMessage() {
      const input = document.getElementById('userInput');
      const text = input.value.trim();
      if (!text) return;

      const chatBox = document.getElementById('chatBox');

      // Messaggio Utente
      const userMsg = document.createElement('div');
      userMsg.className = 'message user';
      userMsg.innerText = text;
      chatBox.appendChild(userMsg);

      input.value = '';
      chatBox.scrollTop = chatBox.scrollHeight;

      // Risposta AI Automatica
      setTimeout(() => {
        const aiMsg = document.createElement('div');
        aiMsg.className = 'message ai';
        aiMsg.innerHTML = `<strong>Direttore Sportivo:</strong><br>Ricevuto Mister! Ho preso nota dell'aggiornamento. Ricordati di riportarlo anche nella nostra chat principale per mantenere la narrazione sempre aggiornata!`;
        chatBox.appendChild(aiMsg);
        chatBox.scrollTop = chatBox.scrollHeight;
      }, 800);
    }
  </script>

</body>
</html>
